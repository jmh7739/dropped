# ── 프론트엔드 (Next.js / Vercel 환경변수) ──────────────────────
# Supabase 프로젝트 > Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 값이 비어 있으면 프론트는 데이터 미연결 안내와 빈 목록을 표시합니다.

# 배포 도메인 (robots.txt / sitemap.xml 절대경로에 사용). 예: https://tt234.com
NEXT_PUBLIC_SITE_URL=

# ── 크롤러 (Python / GitHub Actions Secrets) ────────────────────
# 쓰기 권한이 필요하므로 service_role 키를 사용 (절대 프론트에 노출 금지)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 쿠팡 파트너스 OpenAPI
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# 알리익스프레스 어필리에이트 API
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# 링크프라이스 CPS (G마켓·11번가·위메프·옥션·SSG·롯데온 등 국내몰 통합)
LINKPRICE_AFFILIATE_ID=

# 항공권: Travelpayouts(아비아세일즈) 실 요금 API + 어필리에이트
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# 경매: 공공데이터포털(data.go.kr) 서비스키 (부동산/자동차 법원경매)
DATA_GO_KR_KEY=

# (선택) 텔레그램 알림 봇 — 후순위
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
